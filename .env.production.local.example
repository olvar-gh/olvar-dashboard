# iOS release builds (scripts/ios-release.js, docs/DEPLOY.md). Copy to .env.production.local,
# which is git-ignored, and fill in. Expo reads that file whenever it bundles a Release build,
# including an archive started from Xcode. Never put a secret (sb_secret_...) key here:
# every EXPO_PUBLIC_ value is inlined into the app.

# supabase for real data (fixtures = demo data, refused unless --allow-fixtures)
EXPO_PUBLIC_DATA_SOURCE=supabase
# Supabase project URL (Supabase → Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (starts with sb_publishable_)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Apple Developer Team ID (developer.apple.com → Membership), used to sign archives.
# Not a secret and not bundled into the app. Leave empty to use the team set in Xcode.
APPLE_TEAM_ID=
