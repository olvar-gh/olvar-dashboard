{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production"
    },
    "e2e-test": {
      "withoutCredentials": true,
      "environment": "preview",
      "env": { "EXPO_PUBLIC_DATA_SOURCE": "fixtures" },
      "ios": { "simulator": true }
    }
  },
  "submit": {
    "production": {}
  }
}
