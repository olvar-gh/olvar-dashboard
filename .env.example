# Copy to .env.local (git-ignored) and fill in. Never put a secret (sb_secret_...) key here:
# every EXPO_PUBLIC_ value is bundled into the web and iOS app.

# Supabase project URL from the olvar-gateway setup (local stack: http://127.0.0.1:54321)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (starts with sb_publishable_)
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# supabase | fixtures (fixtures needs no Supabase values)
EXPO_PUBLIC_DATA_SOURCE=fixtures
