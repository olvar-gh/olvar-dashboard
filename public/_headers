# Cloudflare Pages response headers (docs/DEPLOY.md). Expo copies public/ into dist/.
# No long-lived Cache-Control: a removed bundle URL falls back to index.html, which must not be
# cached as if it were that bundle.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
